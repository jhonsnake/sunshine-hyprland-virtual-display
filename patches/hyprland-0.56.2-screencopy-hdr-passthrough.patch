+// color managed clients can query the monitor's image description, so give them the frame in it
+static NColorManagement::PImageDescription captureImageDescription(PHLMONITOR monitor, wl_client* client) {
+    static const auto PHDRPASSTHROUGH = CConfigValue<Config::INTEGER>("misc:screencopy_hdr_passthrough");
+
+    if (*PHDRPASSTHROUGH && monitor && PROTO::colorManagement && PROTO::colorManagement->isClientCMAware(client))
+        return monitor->m_imageDescription;
+
+    return NColorManagement::DEFAULT_SRGB_IMAGE_DESCRIPTION;
+}
